# Reads profiles.txt (the one table of the MCU ports) for SVF_PROFILE and SVF_PORT.
# Include mode sets SVF_KIND, SVF_TARGETS_BIT, SVF_FACES (a ; list), SVF_DRIVER, SVF_BUS, SVF_GREY_KIND_DEFINE.
# Script mode: cmake -DSVF_PROFILE=<p> -DSVF_PORT=<pico|esp32> -P profiles.cmake prints
#   kind=<K> targets=<0x..> faces=<a,b> driver=<d> bus=<b>
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  cmake_minimum_required(VERSION 3.13)
endif()
get_filename_component(_svf_profiles_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)

if(NOT SVF_PROFILE MATCHES "^(colour|grey|mono)$")
  message(FATAL_ERROR "SVF_PROFILE ${SVF_PROFILE}: choose one of colour, grey, mono")
endif()
if(SVF_PORT STREQUAL "pico")
  set(_svf_dcol 4)
  set(_svf_bcol 6)
elseif(SVF_PORT STREQUAL "esp32")
  set(_svf_dcol 5)
  set(_svf_bcol 7)
else()
  message(FATAL_ERROR "SVF_PORT ${SVF_PORT}: pico or esp32")
endif()

if(NOT SVF_PROFILES_TXT)
  set(SVF_PROFILES_TXT "${_svf_profiles_dir}/profiles.txt") # a test may point it at another table
endif()
file(STRINGS "${SVF_PROFILES_TXT}" _svf_rows REGEX "^[^#]")
set(_svf_found FALSE)
foreach(_svf_row IN LISTS _svf_rows)
  string(STRIP "${_svf_row}" _svf_row)
  if(_svf_row STREQUAL "" OR _svf_row MATCHES "^#")
    continue()
  endif()
  separate_arguments(_svf_cols UNIX_COMMAND "${_svf_row}")
  list(LENGTH _svf_cols _svf_ncols)
  if(NOT _svf_ncols EQUAL 8)
    message(FATAL_ERROR "profiles.txt: row '${_svf_row}' has ${_svf_ncols} columns, expected 8")
  endif()
  list(GET _svf_cols 0 _svf_name)
  if(_svf_name STREQUAL SVF_PROFILE)
    set(_svf_found TRUE)
    list(GET _svf_cols 1 SVF_KIND)
    list(GET _svf_cols 2 SVF_TARGETS_BIT)
    list(GET _svf_cols 3 _svf_faces)
    string(REPLACE "," ";" SVF_FACES "${_svf_faces}")
    list(GET _svf_cols ${_svf_dcol} SVF_DRIVER)
    list(GET _svf_cols ${_svf_bcol} SVF_BUS)
  endif()
endforeach()
if(NOT _svf_found)
  message(FATAL_ERROR "SVF_PROFILE ${SVF_PROFILE}: choose one of colour, grey, mono")
endif()

set(SVF_GREY_KIND_DEFINE "")
if(SVF_PROFILE STREQUAL "grey")
  set(SVF_GREY_KIND "GRAY8" CACHE STRING "Kind the grey profile draws (only GRAY8 until card t_8e7da3c1)")
  if(NOT SVF_GREY_KIND STREQUAL "GRAY8")
    message(FATAL_ERROR "SVF_GREY_KIND ${SVF_GREY_KIND}: only GRAY8 until card t_8e7da3c1")
  endif()
  set(SVF_GREY_KIND_DEFINE "SVF_GREY_KIND_GRAY8=1")
endif()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  string(REPLACE ";" "," _svf_faces_out "${SVF_FACES}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo
    "kind=${SVF_KIND} targets=${SVF_TARGETS_BIT} faces=${_svf_faces_out} driver=${SVF_DRIVER} bus=${SVF_BUS}")
endif()
